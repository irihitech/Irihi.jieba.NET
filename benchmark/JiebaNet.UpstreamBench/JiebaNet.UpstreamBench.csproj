<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>JiebaNet.Benchmark</RootNamespace>
    <AssemblyName>JiebaNet.UpstreamBench</AssemblyName>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.14.0" />
    <PackageReference Include="jieba.NET" Version="0.42.2" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\Program.cs" Link="Program.cs" />
    <Compile Include="..\Shared\BenchSuite.cs" Link="BenchSuite.cs" />
  </ItemGroup>

  <!-- Upstream jieba.NET loads its dictionaries from a Resources folder next to
       the application, so provide it from the repo. -->
  <ItemGroup>
    <None Include="..\..\src\Segmenter\Resources\**" Link="Resources\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\test\Segmenter.Tests\Resources\article_social.txt" Link="input\article_social.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\test\Segmenter.Tests\Resources\围城.txt" Link="input\weicheng.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
